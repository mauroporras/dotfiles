{
  "env": {
    "ENABLE_LSP_TOOL": "1",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "statusLine": {
    "type": "command",
    "command": "/bin/bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "spellcheck": {
    "enabled": true
  },

  "autoMemoryEnabled": false,
  "editorMode": "vim",
  "remoteControlAtStartup": true,
  "terminalProgressBarEnabled": false,
  "theme": "auto",

  "//tui": "Links work without pressing cmd, and they have no visual cue.",
  "tui": "fullscreen",

  "//agentPushNotifEnabled": "Sometimes they're useful. Just learn to ignore them.",
  "_agentPushNotifEnabled": false,
  "_preferredNotifChannel": "terminal_bell",

  "//keybindingFlavor": "It was not deleting word by word.",
  "_keybindingFlavor": "readline",

  "//viewMode": "Commented out because scrollback gets too long.",
  "_viewMode": "verbose"
}
