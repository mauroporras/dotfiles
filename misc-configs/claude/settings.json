{
  "env": {
    "ENABLE_LSP_TOOL": "1",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "statusLine": {
    "type": "command",
    "command": "/bin/bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "spellcheck": {
    "enabled": true
  },

  "autoMemoryEnabled": false,
  "editorMode": "vim",
  "remoteControlAtStartup": true,
  "terminalProgressBarEnabled": false,
  "theme": "auto",

  "//01": "Commented out because sometimes they're useful. Just learn to ignore them.",
  "//agentPushNotifEnabled": false,
  "//preferredNotifChannel": "terminal_bell",

  "//02": "Commented out because links don't work yet",
  "//tui": "fullscreen",

  "//03": "Commented out because it was not deleting word by word.",
  "//keybindingFlavor": "readline"
}
