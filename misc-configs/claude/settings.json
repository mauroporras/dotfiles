{
  "env": {
    "ENABLE_LSP_TOOL": "1",
    "CLAUDE_CODE_DISABLE_TERMINAL_TITLE": "1"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "//refreshInterval": "Rate-limit countdowns only re-render on events, so they go stale while idle.",
  "statusLine": {
    "type": "command",
    "command": "/bin/bash ~/.claude/statusline-command.sh",
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "spellcheck": {
    "enabled": true
  },

  "autoMemoryEnabled": false,
  "editorMode": "vim",
  "theme": "auto",

  "//remoteControlAtStartup": "Sometimes it fails at the worst time and blocks the session.",
  "_remoteControlAtStartup": true,

  "//terminalProgressBarEnabled": "It's inconsistend and annoying.",
  "terminalProgressBarEnabled": false,

  "//tui": "Links work without pressing cmd, and they have no visual cue.",
  "tui": "fullscreen",

  "//agentPushNotifEnabled": "Sometimes they're useful. Just learn to ignore them.",
  "_agentPushNotifEnabled": false,
  "_preferredNotifChannel": "terminal_bell",

  "//keybindingFlavor": "It was not deleting word by word.",
  "_keybindingFlavor": "readline",

  "//viewMode": "Scrollback gets too long.",
  "_viewMode": "verbose"
}
