{
  "plansDirectory": ".claude/plans",
  "env": {
    "CLAUDE_CODE_SESSION_NAME": "session-some-project",
    "CLAUDE_CODE_DISABLE_ARTIFACT": 1,
    "CLAUDE_CODE_ENABLE_CFC": "false"
  },
  "permissions": {
    "allow": [],
    "deny": [
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "ask": [],
    "additionalDirectories": [
      "/tmp"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "task format:changed"
          }
        ]
      }
    ]
  }
}
